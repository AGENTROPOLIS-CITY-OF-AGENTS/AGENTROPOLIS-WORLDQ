{
  "$defs": {
    "edge": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
          "type": "string"
        },
        "from_node_id": {
          "minLength": 1,
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "type": "string"
        },
        "relation": {
          "enum": [
            "adjacent-to",
            "contains",
            "enters",
            "exits",
            "connects-to",
            "serves",
            "observes",
            "simulates",
            "depends-on",
            "assigned-to"
          ],
          "type": "string"
        },
        "to_node_id": {
          "minLength": 1,
          "type": "string"
        },
        "traversability_proof": {
          "additionalProperties": false,
          "description": "Proof that this edge is a real traversable or explicitly defined connection. A link in a database does not prove a navigable route exists. Every edge must carry exactly one proof, and the proof must match the connection it claims.",
          "properties": {
            "clearance_m": {
              "description": "Minimum clear width in meters along the route, when the proof is physical. Required for walkable-route, door, and staircase proofs.",
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "door_id": {
              "description": "Identifier of the door the route passes through. Required for door proofs.",
              "type": "string"
            },
            "elevator_id": {
              "description": "Identifier of the elevator used. Required for elevator-ride proofs.",
              "type": "string"
            },
            "evidence": {
              "description": "How the proof was established: measured geometry, walkthrough test, simulation run, or design document reference.",
              "minLength": 1,
              "type": "string"
            },
            "length_m": {
              "description": "Route length in meters, when the proof is physical.",
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "non_physical_definition": {
              "description": "Explicit definition of a non-physical connection, for example a camera observing a room or a service assigned to a building. Required for non-physical-defined proofs.",
              "minLength": 1,
              "type": "string"
            },
            "proof_type": {
              "enum": [
                "walkable-route",
                "door",
                "elevator-ride",
                "staircase",
                "non-physical-defined"
              ],
              "type": "string"
            },
            "route": {
              "description": "Ordered list of node ids forming the route, when the proof is physical. The first entry must be from_node_id and the last must be to_node_id.",
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 2,
              "type": "array"
            },
            "verified_at": {
              "format": "date-time",
              "type": "string"
            },
            "verified_by": {
              "description": "Tool, test, or person that verified the route. Do not invent a verifier.",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "proof_type",
            "evidence",
            "verified_by"
          ],
          "type": "object"
        }
      },
      "required": [
        "edge_id",
        "from_node_id",
        "to_node_id",
        "relation",
        "traversability_proof"
      ],
      "type": "object"
    },
    "node": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "node_id": {
          "minLength": 1,
          "type": "string"
        },
        "node_type": {
          "enum": [
            "district",
            "street",
            "building",
            "floor",
            "room",
            "door",
            "elevator",
            "staircase",
            "asset",
            "npc",
            "agent",
            "service",
            "camera",
            "simulation"
          ],
          "type": "string"
        },
        "position_m": {
          "additionalProperties": false,
          "properties": {
            "x_m": {
              "type": "number"
            },
            "y_m": {
              "type": "number"
            },
            "z_m": {
              "type": "number"
            }
          },
          "required": [
            "x_m",
            "y_m",
            "z_m"
          ],
          "type": "object"
        },
        "ref_id": {
          "description": "Identifier of the scene, asset, or other record this node refers to, when applicable.",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "node_type"
      ],
      "type": "object"
    }
  },
  "$id": "https://agentropolis.example/schemas/spatial-graph.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "PROVISIONAL pending NEURO approval of P0 definitions. Spatial graph for the pilot city. Nodes are places, objects, people, agents, services, cameras, and simulations. Edges MUST correspond to actual traversable or otherwise explicitly defined connections, and every edge carries a traversability proof. A link in a database does not prove a navigable route exists. Referential integrity (edge endpoints exist as nodes, and physical routes start and end at the edge endpoints) is checked by the validation script, not by JSON Schema alone.",
  "properties": {
    "edges": {
      "items": {
        "$ref": "#/$defs/edge"
      },
      "minItems": 1,
      "type": "array"
    },
    "graph_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 2,
      "type": "array"
    },
    "scene_id": {
      "description": "Scene this graph describes.",
      "type": "string"
    },
    "schema_version": {
      "const": "0.2.0",
      "type": "string"
    },
    "status": {
      "const": "PROVISIONAL",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "status",
    "graph_id",
    "scene_id",
    "nodes",
    "edges"
  ],
  "title": "Hermes City World Engine Spatial Graph",
  "type": "object"
}
