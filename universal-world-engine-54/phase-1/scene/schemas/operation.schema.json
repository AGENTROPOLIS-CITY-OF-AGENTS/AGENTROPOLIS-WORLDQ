{
  "$defs": {
    "dimensions_m": {
      "additionalProperties": false,
      "properties": {
        "depth_m": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "height_m": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "width_m": {
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "width_m",
        "depth_m",
        "height_m"
      ],
      "type": "object"
    },
    "operation": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "place_door"
              }
            }
          },
          "then": {
            "required": [
              "connects_to"
            ]
          }
        }
      ],
      "description": "One typed, bounded geometry operation from the P3 allowlist. The executor only accepts these ops. An operation is a job record (how the scene was built), not part of the declarative scene spec. Each operation also maps to one spatial-graph asset node and one geometry node.",
      "properties": {
        "asset_id": {
          "description": "Asset record this operation instantiates, when one exists. Omit when the placed geometry has no asset record; do not invent one.",
          "type": "string"
        },
        "connects_to": {
          "description": "Room id the door connects to. Required when op is place_door.",
          "type": "string"
        },
        "dimensions_m": {
          "$ref": "#/$defs/dimensions_m"
        },
        "material": {
          "description": "Material token from the verified brand palette (REF-MAT-01).",
          "type": "string"
        },
        "object_id": {
          "description": "Identifier of the placed object, for example desk-1.",
          "minLength": 1,
          "type": "string"
        },
        "op": {
          "enum": [
            "place_box",
            "place_cylinder",
            "place_wall_segment",
            "place_door",
            "place_desk",
            "place_light",
            "place_marker"
          ],
          "type": "string"
        },
        "operation_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
          "type": "string"
        },
        "position_m": {
          "$ref": "#/$defs/position_m"
        },
        "room_id": {
          "description": "Room the operation acts in.",
          "minLength": 1,
          "type": "string"
        },
        "schema_version": {
          "const": "0.2.0",
          "type": "string"
        },
        "spatial_graph_node_id": {
          "description": "Spatial-graph node id for the placed object, when one exists.",
          "type": "string"
        },
        "status": {
          "const": "PROVISIONAL",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "op",
        "object_id",
        "room_id",
        "position_m",
        "dimensions_m",
        "material"
      ],
      "type": "object"
    },
    "position_m": {
      "additionalProperties": false,
      "properties": {
        "x_m": {
          "type": "number"
        },
        "y_m": {
          "type": "number"
        },
        "z_m": {
          "type": "number"
        }
      },
      "required": [
        "x_m",
        "y_m",
        "z_m"
      ],
      "type": "object"
    }
  },
  "$id": "https://agentropolis.example/schemas/operation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "op": {
            "const": "place_door"
          }
        }
      },
      "then": {
        "required": [
          "connects_to"
        ]
      }
    }
  ],
  "description": "PROVISIONAL pending NEURO approval of P0 definitions. One typed, bounded geometry operation from the generation-loop allowlist. Version 0.2.0 (new in the P1/P3 reconciliation).",
  "properties": {
    "asset_id": {
      "description": "Asset record this operation instantiates, when one exists. Omit when the placed geometry has no asset record; do not invent one.",
      "type": "string"
    },
    "connects_to": {
      "description": "Room id the door connects to. Required when op is place_door.",
      "type": "string"
    },
    "dimensions_m": {
      "$ref": "#/$defs/dimensions_m"
    },
    "material": {
      "description": "Material token from the verified brand palette (REF-MAT-01).",
      "type": "string"
    },
    "object_id": {
      "description": "Identifier of the placed object, for example desk-1.",
      "minLength": 1,
      "type": "string"
    },
    "op": {
      "enum": [
        "place_box",
        "place_cylinder",
        "place_wall_segment",
        "place_door",
        "place_desk",
        "place_light",
        "place_marker"
      ],
      "type": "string"
    },
    "operation_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "position_m": {
      "$ref": "#/$defs/position_m"
    },
    "room_id": {
      "description": "Room the operation acts in.",
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "0.2.0",
      "type": "string"
    },
    "spatial_graph_node_id": {
      "description": "Spatial-graph node id for the placed object, when one exists.",
      "type": "string"
    },
    "status": {
      "const": "PROVISIONAL",
      "type": "string"
    }
  },
  "required": [
    "operation_id",
    "op",
    "object_id",
    "room_id",
    "position_m",
    "dimensions_m",
    "material",
    "schema_version",
    "status"
  ],
  "title": "Hermes City World Engine Typed Geometry Operation",
  "type": "object"
}
